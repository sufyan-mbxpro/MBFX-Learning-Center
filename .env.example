# Copy to .env and fill in. Real values are never committed.
# Secrets live here (env), never in the database, never in NEXT_PUBLIC_*.

DATABASE_URL="mysql://user:pass@localhost:3306/mbfx_learning_center"
REDIS_URL="redis://localhost:6379"

# Better Auth (packages/auth, Module 04)
BETTER_AUTH_SECRET=""              # openssl rand -base64 32
BETTER_AUTH_URL="http://localhost:3000"

# OAuth providers
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# One app, two surfaces (ADR-006): admin is a path on the same origin.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_ADMIN_URL="http://localhost:3000/admin"

# Media storage (Module 11)
S3_BUCKET=""
S3_REGION=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_HOST=""

# Market data (Module 13)
MARKET_DATA_PROVIDER="alphavantage"
MARKET_DATA_API_KEY=""

# Seed only. Omit in production and force a reset on first login instead.
SEED_ADMIN_EMAIL="admin@mbxpro.com"
SEED_ADMIN_PASSWORD=""
