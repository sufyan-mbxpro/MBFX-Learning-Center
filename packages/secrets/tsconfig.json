{
  "extends": "@repo/typescript-config/base.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    // Named explicitly because this package has NO runtime dependencies, so
    // nothing else drags node's globals in. `node:crypto` and `Buffer` are the
    // whole of its surface.
    "types": ["node"]
  },
  "include": ["src"]
}
